# === Telegram ===
# Token from @BotFather (see README). The bot won't start without it.
BOT_TOKEN=

# === Hack Club AI ===
HACKCLUB_API_KEY=sk-hc-v1-xxxxxxxx

# === Access (tg_id as a comma-separated list) ===
# Admins: /admin, quality mode switching. Find your id via @userinfobot
ADMIN_IDS=
# Regular users (whitelist). Admins always have access.
ALLOWED_IDS=

# === Behavior ===
# Quality mode: econ | medium | max
DEFAULT_MODE=econ
# Daily spend limit (hackai gives $3/day, resets at 00:00 UTC)
DAILY_BUDGET_USD=3.0

# === Paths ===
DATA_DIR=data

# === Own Telegram Bot API server ===
# Container tgapibot is reachable via the voicenet docker network
# (already attached in docker-compose.yml). Removes the 20 MB file limit.
TG_API_BASE=http://tgapibot:8080
