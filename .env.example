# === Telegram ===
# Token from @BotFather (see README). The bot won't start without it.
BOT_TOKEN=

# === Hack Club AI ===
# API key from https://ai.hackclub.com (dashboard -> Keys)
HACKCLUB_API_KEY=

# === Access (comma-separated Telegram user ids) ===
# Admins can use /admin and switch the quality mode. Find your id via @userinfobot
ADMIN_IDS=
# Regular users (whitelist). Admins always have access. Leave empty for admin-only.
ALLOWED_IDS=

# === Behavior ===
# Quality mode: econ | medium | max
DEFAULT_MODE=econ
# Daily spend limit in USD (Hack Club AI allows $3/day, resets at 00:00 UTC)
DAILY_BUDGET_USD=3.0

# === Paths ===
# Where the SQLite database and textbooks are stored (relative to src/ or absolute)
DATA_DIR=data

# === Own Telegram Bot API server (optional) ===
# URL of a self-hosted telegram-bot-api instance. Removes Telegram's 20 MB
# download limit, so textbooks can be sent as documents directly in chat.
# Leave empty to use the official api.telegram.org.
TG_API_BASE=
